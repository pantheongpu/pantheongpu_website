# Pantheon with the CUDA toolchain preinstalled.
#
# The wheel compiles its kernels on first run, which needs nvcc, make and g++;
# carrying them in the image is the whole point — a user runs
#
#   docker run --rm --gpus all -v "$PWD:/reports" \
#     ghcr.io/pantheongpu/pantheon:latest --test tensor_virus --duration 60
#
# and never installs a toolkit. CUDA 12.8 is the newest toolkit in the weekly
# compile matrix that still runs on the broad installed base of 12.x drivers;
# a newer toolkit would demand newer drivers from every user for no gain, since
# kernels are compiled for the GPU actually present at first run.
#
# Reports are written to the working directory, so mount one at /reports.
# The compiled-kernel cache lives in the image user's XDG cache; mount
# /root/.cache to keep it across containers and skip the one-minute rebuild.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-pip make g++ \
    && rm -rf /var/lib/apt/lists/*

ARG PANTHEON_WHEEL=pantheon_gpu-1.2.0-py3-none-any.whl
COPY ${PANTHEON_WHEEL} /tmp/${PANTHEON_WHEEL}

# Ubuntu 24.04's python is externally managed (PEP 668); the image exists to
# run exactly this one tool, so installing into the system environment is the
# intended use, not a hazard worth a venv.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        "/tmp/${PANTHEON_WHEEL}[reports]" \
    && rm "/tmp/${PANTHEON_WHEEL}" \
    && pantheon --version

WORKDIR /reports
ENTRYPOINT ["pantheon"]
CMD ["--help"]
